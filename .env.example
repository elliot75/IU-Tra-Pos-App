# 複製為 .env，僅供本機開發；請勿提交密碼。
HOST=127.0.0.1
PORT=3000
# 安全預設：loopback / LAN HTTP 都不能登入，需 HTTPS 可信代理。
AUTH_TRANSPORT_MODE=https-proxy
# 逗號分隔的代理來源 IP；不接受 hostname、CIDR、萬用字元，空白不信任任何代理。
TRUSTED_PROXY_IPS=
# 同機代理範例（依實際來源設定）：TRUSTED_PROXY_IPS=127.0.0.1,::1
# 代理必須覆寫 X-Forwarded-Proto 與 X-Real-IP，不可附加或信任客戶端值。
# 必須以 HOST / 防火牆阻擋繞過代理直接連線；代理拒絕 HTTP 登入。
# 僅本機開發才改為 AUTH_TRANSPORT_MODE=local-development，維持 HOST=127.0.0.1
# 以及 TRUSTED_PROXY_IPS= 空白。此模式只放行 loopback HTTP，不放行 LAN HTTP。
# 區網測試可改為 AUTH_TRANSPORT_MODE=lan-development，HOST=0.0.0.0
# 並維持 TRUSTED_PROXY_IPS= 空白。允許私有網路、loopback 及 100.111.0.0/16 HTTP 登入。
# Tailscale 請使用伺服器的 100.x 位址連線，客戶端來源須在 100.111.0.0/16。
# 此模式密碼與 token 未經 TLS 加密；僅供自己的可信區網開發測試。
# 實驗性未付款訂單草稿 API 預設停用；只可在獨立測試環境明確啟用。
# ENABLE_EXPERIMENTAL_ORDER_DRAFTS=true
# 營運工作台 /operations 的 API 預設停用；靜態頁可開啟不代表已啟用。
# 先在獨立測試副本審閱並手動執行 004_operations.sql（依賴 001/002，不需 003）。
# scripts/configure-pos.js <設定檔> --check 僅驗證格式；--apply 才連線配置門市、設備、授權。
# 設備 key 存放受控的 private/pos-config.json，不是此處的 HMAC key。
# 錢包／退款另受門市 policy 控制；未經政策／資金／設備驗收不能正式營業。
ENABLE_POS_OPERATIONS=false
# 啟用前產生至少 32 字元的隨機秘密，所有服務實例、重啟與災難復原都須沿用同一值。
# 此 key 用於原操作內容 HMAC；變更會使既有同鍵重試出現內容衝突，不能隨意輪替。
# 勿使用文件或測試中的固定值；透過秘密管理保管及另行備援，不加入 Git／一般日誌。
# POS_REQUEST_HMAC_KEY=
# 加密備份專用的獨立 AES-256 金鑰：32 bytes 隨機值的 Base64，不與 HMAC／設備秘密共用。
# backup-pos.js backup / stage-restore 均需此 key；遺失即無法解密，輪替須保留舊備份對應 key。
# 備份包不包含此 key、HMAC key、設備秘密或 .env，須在包外安全保存並記錄對應版本。
# stage-restore 僅驗證解密至全新目錄，不連線或還原資料庫。完整流程見 docs/operations.md。
# POS_BACKUP_KEY_BASE64=
# PostgreSQL 連線字串；尚未設定時仍可使用示範菜單。
# DATABASE_URL=postgresql://user:password@localhost:5432/iutra
# 跨網路連線請依供應商文件設定 TLS，並確認 CA 驗證方式。
# PGSSLROOTCERT=/absolute/path/to/ca.pem
